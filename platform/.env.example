# Required for harness turns (any Anthropic-compatible API key).
ANTHROPIC_API_KEY=sk-...

# Optional: point at an Anthropic-compatible proxy. The Pi harness passes
# it to the Anthropic SDK, which appends `/v1/messages`, so leave `/v1` out.
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# Optional: extra HTTP headers comma-separated. Used when the proxy
# requires e.g. a sub-module gating header.
# ANTHROPIC_CUSTOM_HEADERS=X-Sub-Module: my-module

# Optional: override the listening port (host side). Defaults to 8787.
# OMA_PORT=8787

# Optional: switch the SQL backend from sqlite (default) to Postgres.
# DATABASE_URL takes precedence over DATABASE_PATH.
# DATABASE_URL=postgres://oma:oma@postgres:5432/oma

# Auth secret. Required for prod — sessions are signed with it; sessions
# don't survive restart if missing. Generate one with:
#   openssl rand -hex 32
BETTER_AUTH_SECRET=

# Required: root key of the platform ciphers (vault credentials, model card
# API keys, Session resources). The server starts without it, but these
# ciphers stay unavailable.
# Generate with:
#   openssl rand -base64 32
PLATFORM_ROOT_SECRET=

# Public base URL — used for cookie domain + OAuth redirect URLs. Defaults
# to "*" trusted-origins if missing (only OK for local dev).
# PUBLIC_BASE_URL=https://oma.example.com

# Optional: bypass auth entirely. Every request becomes tenant_id="default".
# Use ONLY for local single-user demos. Production must leave this unset.
# AUTH_DISABLED=1

# Optional: account sign-in OAuth. Register callbacks at:
#   ${PUBLIC_BASE_URL}/auth/callback/google
#   ${PUBLIC_BASE_URL}/auth/callback/github
# A provider is advertised by /auth-info only when both values are set.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# Sandbox provider. Required by deployable Node entrypoints. The only
# accepted backend is LiteBox (alias boxlite):
#
#   litebox              — BoxLite local micro-VM (Firecracker per box).
#                          Hardware isolation, no daemon, needs /dev/kvm.
#                          Optional: LITEBOX_MEMORY_MIB, LITEBOX_CPUS,
#                          SANDBOX_IMAGE.
#
# SANDBOX_PROVIDER=litebox
# SANDBOX_IMAGE=node:22-slim
# LITEBOX_MEMORY_MIB=512
# LITEBOX_CPUS=2

# Sandbox image catalog (docs/plans/environments.md, 1.5). An environment
# whose config.image names a catalog key boots its LiteBox VM from that
# image, with the disk, memory and CPUs of its catalog entry: an OCI layout
# that platform/sandbox-images/build.sh wrote to SANDBOX_IMAGE_DIR, or a
# registry reference pinned by digest. The server reads the catalog for
# every such VM and the adapter checks the layout digest against its
# index.json; an unknown or unbuilt image fails the session by name.
# Environments without config.image keep SANDBOX_IMAGE and LITEBOX_*.
# SANDBOX_IMAGE_CATALOG=/srv/openma/platform/sandbox-images/catalog.json
# SANDBOX_IMAGE_DIR=./data/sandbox-images

# Memory store blobs in an S3-compatible bucket. When all four are set, the
# server keeps memory blobs there and polls the bucket for changes
# (MEMORY_S3_POLL_INTERVAL_SEC, 30 by default). Without them, memory blobs
# live on local disk under MEMORY_BLOB_DIR (./data/memory-blobs).
#
# MEMORY_S3_ENDPOINT=https://s3.us-west-2.amazonaws.com
# MEMORY_S3_ACCESS_KEY=
# MEMORY_S3_SECRET_KEY=
# MEMORY_S3_BUCKET=oma-memory
